{
  "name": "@blueshift/beethoven/dflow",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.30.2",
    "tsdown": "^0.21.2",
    "typescript": "^5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "private": true,
  "scripts": {
    "openapi": "openapi-generator-cli generate -i /local/openapi.yaml -o /local/src/generated -g typescript-fetch --skip-validate-spec --additional-properties=supportsES6=true,typescriptThreePlus=true,useSingleRequestParameter=true,modelPropertyNaming=original",
    "type-check": "tsc -p tsconfig.build.json --noEmit",
    "build": "tsdown --config tsdown.config.ts",
    "ci": "bun run openapi && bun run type-check && bun run build"
  },
  "type": "module"
}
